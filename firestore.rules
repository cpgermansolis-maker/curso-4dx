// =========================================================
// REGLAS DE SEGURIDAD DE FIRESTORE para TRIKLES
// =========================================================
// ESTADO ACTUAL (2026-05-14): RESTAURACIÓN POST-TRIAL
//
// El modo "prueba" inicial de 30 días expiró y bloqueó el acceso de los
// alumnos a sus cursos. Estas reglas reabren temporalmente la base de
// datos con el mismo perfil de acceso que el modo prueba tenía: lectura/
// escritura libre para cualquier cliente. Es lo mínimo necesario para
// que el sitio actual (que usa lecturas anónimas desde admin.html y
// lecturas autenticadas desde curso.html / index.html) vuelva a operar
// SIN cambios de código.
//
// IMPORTANTE — esto NO es un estado final.
//
// PRÓXIMO PASO (cuando se aborde): endurecer las reglas para que:
//   - Cada alumno solo pueda leer/escribir su propio doc users/{email}
//     (regla: request.auth.token.email.lower() == email)
//   - admin.html sea migrado a Firebase Auth con un custom claim
//     "admin = true" sobre la cuenta cpgermansolis@gmail.com, y las
//     reglas permitan lectura global cuando request.auth.token.admin == true
//   - Las colecciones ratings, enrollments, etc. queden similarmente acotadas
//
// Cómo aplicar (desde la raíz del repo, requiere que firebase.json incluya
// la sección "firestore" apuntando a este archivo):
//   npx firebase-tools deploy --only firestore:rules --project trikles-cursos
// =========================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // TEMPORAL: acceso abierto post-trial — endurecer en próxima iteración
      allow read, write: if true;
    }
  }
}
