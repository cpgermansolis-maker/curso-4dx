// =========================================================
// REGLAS DE SEGURIDAD DE FIRESTORE — TRIKLES
// =========================================================
// Modelo de acceso:
//
// users/{email}
//   - Lectura/escritura: dueño del doc (correo autenticado coincide con
//     el ID del doc, en minúsculas) o admin.
//
// ratings/{ratingId}   (formato del ID: "email__courseId")
//   - Lectura: pública (el catálogo público muestra promedio y reseñas).
//   - Crear/actualizar: solo el autor (ratingId arranca con su correo
//     autenticado) o admin.
//   - Borrar: solo admin.
//
// Quien es "admin": cualquier usuario autenticado que tenga el custom
// claim { admin: true } en su token. Ese claim se asigna vía la Cloud
// Function `bootstrapAdmin`, que solo lo otorga a cpgermansolis@gmail.com.
//
// Cualquier otra colección queda denegada por defecto.
//
// Despliegue:
//   npx firebase-tools deploy --only firestore:rules --project trikles-cursos
// =========================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function callerEmail() {
      return request.auth != null && request.auth.token.email != null
              ? request.auth.token.email.lower()
              : '';
    }

    function isOwnerOfEmailDoc(emailId) {
      return callerEmail() != '' && callerEmail() == emailId;
    }

    // === Usuarios (perfil + enrollments + progreso por curso) ===
    match /users/{email} {
      allow read, write: if isOwnerOfEmailDoc(email) || isAdmin();
    }

    // === Calificaciones de cursos ===
    // ratingId tiene formato "email__courseId" (ver firebase-init.js _ratingId).
    // Comparamos prefijo por split en vez de regex para evitar metachars en
    // correos (los puntos y el + de un correo "ana+test@example.com" serian
    // metachars en regex y debilitarian la verificacion de pertenencia).
    match /ratings/{ratingId} {
      allow read: if true;

      allow create, update: if isAdmin()
          || (callerEmail() != '' && ratingId.split('__')[0] == callerEmail());

      allow delete: if isAdmin();
    }

    // === Cualquier otra ruta: denegado ===
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
